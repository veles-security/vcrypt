@startuml "vcrypt concept"

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package vapi {
    interface "Encoder<A, O>" as VapiEncoder
    interface "Decoder<A, O>" as VapiDecoder
    interface Artifact
}

package key {
    class KeyCandidate {
        + ID string
        + Source string
        + Status KeyStatus
        + Material Material
    }

    class Key {
        + ID() string
        + Material() Material
        + Backend() Backend
    }

    interface Backend {
        + Supports(use, operation, algorithm) bool
        + Capabilities() []Capability
    }

    interface JOSEEncoder {
        + Encode(ctx, Key, options) []byte
        + SupportsMaterial(Material) bool
    }

    interface JOSEDecoder {
        + Decode(ctx, encoded, options) KeyCandidate
        + SupportsJOSEKeyType(kty) bool
    }

    Key *-- Backend
}

package material {
    interface Material
    class PublicMaterial
    class PrivateMaterial
    class CertificateMaterial
    class SymmetricMaterial

    Material <|.. PublicMaterial
    Material <|.. PrivateMaterial
    Material <|.. CertificateMaterial
    Material <|.. SymmetricMaterial
}

KeyCandidate --> Material
Key --> Material
Artifact <|.. KeyCandidate
Artifact <|.. Key
VapiEncoder <|-- JOSEEncoder
VapiDecoder <|-- JOSEDecoder

package descriptor {
    class "JWKS<A>" as JWKS {
        + Keys []A
        + Kind() string
    }

    class JWKSEncoder {
        + Encode(ctx, JWKS<Key>, options) []byte
    }

    class JWKSDecoder {
        + Decode(ctx, encoded, options) JWKS<KeyCandidate>
    }

    Artifact <|.. JWKS
    VapiEncoder <|.. JWKSEncoder
    VapiDecoder <|.. JWKSDecoder
    JWKSEncoder --> JWKS
    JWKSDecoder --> JWKS
}

package backend {
    interface Factory {
        + Supports(Material) bool
        + New(Material) Backend
    }

    class "Backend registry" as BackendRegistry {
        + Regsiter(Factory)
        + BackendFor(Material) Backend
    }

    class "Codec registry" as CodecRegistry {
        + RegisterJOSEEncoder(JOSEEncoder)
        + RegisterJOSEDecoder(JOSEDecoder)
        + JOSEEncoderFor(Material) JOSEEncoder
        + JOSEDecoderFor(kty) JOSEDecoder
    }

    BackendRegistry o-- Factory
    CodecRegistry o-- JOSEEncoder
    CodecRegistry o-- JOSEDecoder
}

JWKSEncoder --> CodecRegistry : selects by material
JWKSDecoder --> CodecRegistry : selects by kty

package "backend implementations" {
    class "RSA components" as RSA
    class "EC components" as EC
    class "symmetric components" as Symmetric
}

Factory <|.. RSA
Factory <|.. EC
Factory <|.. Symmetric
Backend <|.. RSA
Backend <|.. EC
Backend <|.. Symmetric
JOSEEncoder <|.. RSA
JOSEDecoder <|.. RSA

package keysource {
    interface Source {
        + ID() string
        + Load() []KeyCandidate
    }

    interface SelfRefreshingSource {
        + SetRefreshCallback(func([]KeyCandidate) error)
    }

    class FileSource
    class RandomSource
    class JWKSSource

    Source <|-- SelfRefreshingSource
    SelfRefreshingSource <|.. FileSource
    SelfRefreshingSource <|.. RandomSource
    SelfRefreshingSource <|.. JWKSSource
    Source --> KeyCandidate : loads
    JWKSSource --> JWKSDecoder : uses
}

package keystore {
    interface Repository {
        + Find(ctx, selector) []Key
        + Replace(ctx, keys, selector) error
    }

    class Store {
        + Bind(Source) error
        + RefreshAll() error
        + Sign(ctx, message, options) SignResult
        + VerifySignature(ctx, message, signature, options) error
    }

    Store *-- Repository
    Store o-- Source
}

Store --> BackendRegistry : builds candidates
Repository o-- Key

@enduml
